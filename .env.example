# Optional live imagery catalogs. Read-only search; the service never places an order.

# Roscosmos Geoportal (ЕТРИС ДЗЗ, ЦБГД API). Either a ready OAuth access token of an ETRIS account...
ETRIS_ACCESS_TOKEN=
# ...or the password grant: an ETRIS account from gptl.ru and a client_id issued by the ЦБГД developers.
ETRIS_CLIENT_ID=
ETRIS_CLIENT_SECRET=
ETRIS_USERNAME=
ETRIS_PASSWORD=

# SkyFi marketplace (prices in US dollars).
SKYFI_API_KEY=
